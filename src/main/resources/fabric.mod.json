{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${mod_version}",
  "name": "${mod_name}",
  "description": "${mod_description}",
  "authors": [
    "${mod_author}"
  ],
  "contact": {
    "homepage": "${mod_sources}",
    "sources": "${mod_sources}"
  },
  "license": "MIT",
  "icon": "assets/easy_homes/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "ivkond.mc.mods.eh.fabric.EasyHomesModFabric"
    ],
    "client": [
      "ivkond.mc.mods.eh.fabric.client.EasyHomesModFabricClient"
    ],
    "modmenu": [
      "ivkond.mc.mods.eh.fabric.client.ModMenuConfiguration"
    ],
    "fabric-gametest": [
      "ivkond.mc.mods.eh.gametest.SetHomeScenarios",
      "ivkond.mc.mods.eh.gametest.HomeScenarios",
      "ivkond.mc.mods.eh.gametest.DelHomeScenarios",
      "ivkond.mc.mods.eh.gametest.RenHomeScenarios",
      "ivkond.mc.mods.eh.gametest.BackScenarios",
      "ivkond.mc.mods.eh.gametest.HomesScenarios"
    ]
  },
  "mixins": [
    "easy_homes.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${fabric_loader_version}",
    "minecraft": "${minecraft_dependency}",
    "java": ">=${java}",
    "fabric-api": "*"
  }
}
